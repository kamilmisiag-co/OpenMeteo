    "howScores.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Each activity gets a score from 0 to 100 for every day, from that day’s forecast. The score for the period is the mean of its %lld day, and activities are ranked by it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Each activity gets a score from 0 to 100 for every day, from that day’s forecast. The weekly score is the mean of the %lld days, and activities are ranked by it."
                }
              }
            }
          }
        }
      }
    },
